# Local PostgreSQL container. Copy to .env and replace every CHANGE_ME value.
POSTGRES_DB=erp
POSTGRES_USER=erp_app
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
ERP_DB_PORT=54318

# API configuration. Never commit real credentials.
ConnectionStrings__ErpDatabase="Host=localhost;Port=54318;Database=erp;Username=erp_app;Password=CHANGE_ME_LOCAL_ONLY"
ERP_SEED_OWNER_PASSWORD=CHANGE_ME_AT_LEAST_12_CHARS
ERP_ALLOWED_ORIGINS=http://localhost:5173
# Production host allow-list behind Nginx. Use semicolons; do not use * on an Internet-facing host.
AllowedHosts=erp.example.com
# Required outside Development. Use a random value of at least 32 bytes and keep it stable.
CustomerPrivacy__LookupPepper=CHANGE_ME_RANDOM_32_BYTES_OR_MORE
# Required outside Development for one-time member verification code hashing.
MemberVerification__CodePepper=CHANGE_ME_DIFFERENT_RANDOM_32_BYTES_OR_MORE
# Required outside Development. Used only for irreversible login-account event lookups.
SecurityEvents__AccountHashPepper=CHANGE_ME_LOGIN_EVENT_RANDOM_32_BYTES_OR_MORE
# Required outside Development. Used for encrypted merchant registration contact lookup.
PlatformRegistration__ContactHashPepper=CHANGE_ME_REGISTRATION_RANDOM_32_BYTES_OR_MORE
# Required outside Development. Keep both directories outside versioned release folders and back them up together.
FileStorage__RootPath=/var/lib/erp/attachments
DataProtection__KeyRingPath=/var/lib/erp/data-protection-keys

# One-time production empty-database bootstrap. Set only for the bootstrap process, then remove all values.
# Never put the owner password in command-line arguments, scripts, source control, or deployment logs.
ERP_BOOTSTRAP_CONFIRM=CREATE_NEW_ERP
ERP_BOOTSTRAP_TENANT_CODE=B01
ERP_BOOTSTRAP_TENANT_NAME=CHANGE_ME_BRAND_NAME
ERP_BOOTSTRAP_STORE_CODE=S01
ERP_BOOTSTRAP_STORE_NAME=CHANGE_ME_STORE_NAME
ERP_BOOTSTRAP_STORE_TIME_ZONE=Asia/Shanghai
ERP_BOOTSTRAP_OWNER_ACCOUNT=CHANGE_ME_OWNER_ACCOUNT
ERP_BOOTSTRAP_OWNER_DISPLAY_NAME=CHANGE_ME_OWNER_NAME
ERP_BOOTSTRAP_OWNER_EMPLOYEE_NO=E0001
ERP_BOOTSTRAP_OWNER_POSITION=负责人
ERP_BOOTSTRAP_OWNER_PASSWORD=CHANGE_ME_STRONG_INITIAL_PASSWORD

# One-time platform administrator bootstrap. This identity is outside every merchant tenant.
ERP_PLATFORM_BOOTSTRAP_CONFIRM=CREATE_PLATFORM_ADMIN
ERP_PLATFORM_ADMIN_ACCOUNT=CHANGE_ME_PLATFORM_ACCOUNT
ERP_PLATFORM_ADMIN_DISPLAY_NAME=平台管理员
ERP_PLATFORM_ADMIN_PASSWORD=CHANGE_ME_STRONG_INITIAL_PASSWORD

# Payment-channel credential profiles. Keep key files under an ignored, access-controlled directory.
# Database rows only store profile names such as PRIMARY_WECHAT and never store these values.
# The API appends /{configurationId} to each NotifyUrl base when creating a channel order.
PaymentChannels__Profiles__PRIMARY_WECHAT__AppId=CHANGE_ME_WECHAT_APP_ID
PaymentChannels__Profiles__PRIMARY_WECHAT__MerchantId=CHANGE_ME_WECHAT_MERCHANT_ID
PaymentChannels__Profiles__PRIMARY_WECHAT__MerchantCertificateSerial=CHANGE_ME_CERTIFICATE_SERIAL
PaymentChannels__Profiles__PRIMARY_WECHAT__ApiV3Key=CHANGE_ME_EXACTLY_32_CHARACTERS
PaymentChannels__Profiles__PRIMARY_WECHAT__MerchantPrivateKeyPath=CHANGE_ME_ABSOLUTE_PRIVATE_KEY_PATH
PaymentChannels__Profiles__PRIMARY_WECHAT__PlatformPublicKeyPath=CHANGE_ME_ABSOLUTE_PLATFORM_PUBLIC_KEY_PATH
PaymentChannels__Profiles__PRIMARY_WECHAT__PlatformPublicKeyId=CHANGE_ME_PLATFORM_PUBLIC_KEY_ID
PaymentChannels__Profiles__PRIMARY_WECHAT__NotifyUrl=https://CHANGE_ME_HOST/api/integrations/payment-notifications/wechat

PaymentChannels__Profiles__PRIMARY_ALIPAY__AppId=CHANGE_ME_ALIPAY_APP_ID
PaymentChannels__Profiles__PRIMARY_ALIPAY__MerchantPrivateKeyPath=CHANGE_ME_ABSOLUTE_PRIVATE_KEY_PATH
PaymentChannels__Profiles__PRIMARY_ALIPAY__AlipayPublicKeyPath=CHANGE_ME_ABSOLUTE_ALIPAY_PUBLIC_KEY_PATH
PaymentChannels__Profiles__PRIMARY_ALIPAY__NotifyUrl=https://CHANGE_ME_HOST/api/integrations/payment-notifications/alipay
PaymentChannels__Profiles__PRIMARY_ALIPAY__GatewayUrl=https://openapi.alipay.com/gateway.do
